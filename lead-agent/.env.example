# Lead-Agent - eigene, schmale Env-Datei (nicht backend/.env), gleiche
# Begründung wie dev-agent/.env.example: dieser isolierte Container soll
# nicht die restlichen Backend-Secrets (SMTP, Buffer, Google, ...) sehen.

# Gleiches Claude-Code-Abo/Token wie das Hauptbackend und dev-agent (kein
# Sicherheitsgrenze, nur Abrechnung) - siehe backend/.env.example,
# `claude setup-token`. KEIN ANTHROPIC_API_KEY nötig/genutzt (Entscheidung
# 2026-09-04: Abo-Billing statt API-Key, wie dev-agent/).
CLAUDE_CODE_OAUTH_TOKEN=

# ── Close CRM ────────────────────────────────────────────────────────────
# aus Close: Settings -> API Keys -> Create new API key
CLOSE_API_KEY=

# aus Close: Settings -> Webhooks -> gewünschten Webhook anlegen/auswählen
# -> "Signing key". OHNE gesetztes Secret werden eingehende Webhooks
# abgelehnt (fail-closed), siehe webhooks.py.
CLOSE_WEBHOOK_SIGNING_KEY=

# Custom-Field-ID (NICHT der Anzeigename) für das "Quelle"-Feld, das neue
# Leads als "prozessia-lead-agent" markiert. Erst nach dem Anlegen des
# Custom Fields in Close (Settings -> Custom Fields -> Lead -> neues Feld
# "Quelle", Typ Text) verfügbar - die ID gibt z.B.
# GET /custom_field/lead/ (siehe close_client.list_lead_custom_fields())
# oder die Close-UI beim Bearbeiten des Feldes in der URL preis.
CLOSE_SOURCE_FIELD_ID=
